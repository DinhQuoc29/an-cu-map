 Sao chép file này thành .env và điền giá trị thật (KHÔNG commit .env)

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ancu
DB_USER=ancu
DB_PASSWORD=changeme

# Valhalla routing engine
VALHALLA_URL=http://localhost:8002

# OpenAQ (https://openaq.org – cần đăng ký key miễn phí)
OPENAQ_API_KEY=

# Open-Meteo Air Quality (không cần key ở plan miễn phí)
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com

# Spring profiles: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

